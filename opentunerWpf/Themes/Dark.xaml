<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#FF1B1D21</Color>
    <Color x:Key="SurfaceBackgroundColor">#FF24272C</Color>
    <Color x:Key="SurfaceAltColor">#FF2A2E34</Color>
    <Color x:Key="BorderColor">#FF363B42</Color>
    <Color x:Key="TextPrimaryColor">#FFE7E9EC</Color>
    <Color x:Key="TextSecondaryColor">#FF9AA1AB</Color>
    <Color x:Key="AccentColor">#FF4C8DFF</Color>
    <Color x:Key="AccentHoverColor">#FF5A98FF</Color>
    <Color x:Key="AccentPressedColor">#FF3B7BEB</Color>
    <Color x:Key="ButtonBackgroundColor">#FF2C3037</Color>
    <Color x:Key="ButtonHoverColor">#FF363B43</Color>
    <Color x:Key="ButtonPressedColor">#FF3E444D</Color>
    <Color x:Key="VideoBackgroundColor">#FF0F1114</Color>
    <Color x:Key="MenuBackgroundColor">#FF22252A</Color>
    <Color x:Key="InputBackgroundColor">#FF31353C</Color>
    <Color x:Key="InputBorderColor">#FF464C55</Color>
    <Color x:Key="HighlightColor">#FF33415A</Color>

    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="{StaticResource SurfaceBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonHover" Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="ButtonPressed" Color="{StaticResource ButtonPressedColor}" />
    <SolidColorBrush x:Key="VideoBackground" Color="{StaticResource VideoBackgroundColor}" />
    <SolidColorBrush x:Key="MenuBackground" Color="{StaticResource MenuBackgroundColor}" />
    <SolidColorBrush x:Key="InputBackground" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="InputBorder" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="Highlight" Color="{StaticResource HighlightColor}" />

</ResourceDictionary>
